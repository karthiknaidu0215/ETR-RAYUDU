# PostgreSQL database URL (Neon, Supabase, Vercel Postgres, Render, or Railway)
# Automatically stores plants, bills, plans, settings, and uploaded image records
DATABASE_URL=

# Vercel Blob permanent object storage token
# Auto-created when you add a Blob store in Vercel Dashboard -> Storage -> Blob
# Provides permanent global CDN URLs for all uploaded plant photographs
BLOB_READ_WRITE_TOKEN=