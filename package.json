{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/one-acre-land",
    "build": "npm run build --workspace=@workspace/one-acre-land && npm run build --workspace=@workspace/api-server",
    "start": "node server.mjs",
    "serve": "node server.mjs",
    "lint": "npm run typecheck --workspace=@workspace/one-acre-land"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "@vercel/blob": "^2.8.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/multer": "^2.3.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
